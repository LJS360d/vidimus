{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "scripts/*.ts",
    "test/**/*.test.ts",
    "docs/vidimus.config.ts",
    "docs/react/src/main.tsx",
    "docs/react/vite.config.ts",
    "docs/angular/src/main.ts",
    "docs/showcase/showcase.ts",
    "docs/showcase/vite.config.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "docs/**/*.{ts,tsx,astro}"],
  "ignoreDependencies": [
    "html-validate",
    "lighthouse",
    "pa11y",
    "@11ty/eleventy",
    "@angular/build",
    "@angular/cli",
    "@angular/compiler-cli",
    "tslib"
  ],
  "ignoreUnresolved": ["peer-types\\.ts$", "^\\./pages$"],
  "astro": {
    "config": ["docs/astro/astro.config.ts"],
    "entry": ["docs/astro/src/content.config.ts", "docs/astro/src/components/*.astro"]
  },
  "vitepress": {
    "config": ["docs/.vitepress/config.ts"],
    "entry": ["docs/.vitepress/theme/index.ts"]
  }
}
